        '<div class="vxbg-beam b1"></div>' +
        '<div class="vxbg-beam b2"></div>' +
        '<div class="vxbg-stars"></div>';

      document.body.insertBefore(bg, document.body.firstChild);

      var starField = bg.querySelector(".vxbg-stars");
      var starCount = window.matchMedia("(max-width: 600px)").matches ? 35 : 75;
      var fragment = document.createDocumentFragment();

      for (var i = 0; i < starCount; i++) {
        var star = document.createElement("span");
        star.className = "vxbg-star";
        star.style.left = (Math.random() * 100) + "%";
        star.style.top = (Math.random() * 100) + "%";
        star.style.setProperty("--duration", (2 + Math.random() * 5) + "s");
        star.style.setProperty("--delay", (-Math.random() * 6) + "s");
        fragment.appendChild(star);
      }

      starField.appendChild(fragment);
    }

    var startButton = home.querySelector("[data-vh-start]");
    var statusNode = home.querySelector("[data-vh-status]");

    function openTokenForm() {
      var form = document.getElementById("VXTON_FORM_02");

      if (!form) {
        statusNode.textContent =
          "Step 02 not found. Install Step 02 on this same page first.";
        return;
      }

      form.hidden = false;
      form.style.setProperty("display", "block", "important");
      form.setAttribute("aria-hidden", "false");

      window.dispatchEvent(new CustomEvent("vxton:open-token-form"));
      document.dispatchEvent(new CustomEvent("vxton:open-token-form"));

      statusNode.textContent = "Token form opened.";

      window.setTimeout(function () {
        form.scrollIntoView({
          behavior: "smooth",
          block: "start"
        });
      }, 120);
    }

    startButton.addEventListener("click", openTokenForm);

    window.addEventListener("vxton:back-to-home", function () {
      home.scrollIntoView({
        behavior: "smooth",
