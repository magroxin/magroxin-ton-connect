<script>
(function(){
"use strict";

const ROOT=document.getElementById("VXTON_REVIEW_03");
if(!ROOT||ROOT.dataset.initialized==="yes")return;
ROOT.dataset.initialized="yes";

const API="https://magroxin-ton-api.onrender.com";
const MAINNET="-239";
const $=id=>ROOT.querySelector("#"+id);

const state={
  draft:null,
  wallet:null,
  address:"",
  friendlyAddress:"",
  order:null,
  paymentReady:false,
  busy:false,
  servicePaid:false,
  tonUI:null
};

function status(id,msg){
  const n=$(id);
  if(n)n.textContent=String(msg||"");
}

function show(id,yes){
  const n=$(id);
  if(n)n.classList.toggle("vx-hidden",!yes);
}

function button(id,disabled,label){
  const n=$(id);
  if(!n)return;
  n.disabled=!!disabled;
  if(label)n.textContent=label;
}

function connectedMainnet(){
  return !!(
    state.wallet &&
    state.address &&
    state.wallet.account &&
    state.wallet.account.chain===MAINNET
  );
}

function refreshButtons(){
  const connected=connectedMainnet();
  const hasOrder=!!state.order;

  button(
    "VX03_createOrder",
    state.busy||!connected||!state.draft||
    !$("VX03_accept").checked||hasOrder
  );

  button(
    "VX03_payService",
    state.busy||!connected||!hasOrder||
    !state.paymentReady||state.servicePaid
  );

  button(
    "VX03_verifyService",
    state.busy||!connected||!hasOrder||state.servicePaid
  );

  
  show("VX03_disconnectWallet",!!(state.wallet&&state.address));
}

function openSuccessPopup(){
  show("VX03_successPopup",true);
  $("VX03_popupClose").focus();
}

function closeSuccessPopup(){
  show("VX03_successPopup",false);
}

function safeText(v,max){
  return typeof v==="string"||typeof v==="number"
    ?String(v).slice(0,max):"";
}

function normalizeLogo(raw,mimeHint){
  if(!raw)return "";

  let value=raw;
  let mime=mimeHint||"image/png";

  if(typeof raw==="object"){
    mime=raw.mimeType||raw.contentType||raw.type||mime;
    value=raw.dataUrl||raw.dataURL||raw.base64||
      raw.data||raw.url||raw.src||"";
  }

  if(typeof value!=="string")return "";
  value=value.trim();

  if(/^data:image\/(png|jpeg|jpg|webp|gif);base64,/i.test(value))
    return value;

  if(/^https:\/\/[^\s]+$/i.test(value))
    return value;

  const bare=value.replace(/\s/g,"").replace(/^base64,/i,"");

  if(bare&&/^[A-Za-z0-9+/]+={0,2}$/.test(bare)){
    if(!/^image\/(png|jpeg|jpg|webp|gif)$/i.test(mime))
      mime="image/png";
    return "data:"+mime+";base64,"+bare;
  }

  return "";
}

function parseDraft(raw){
  if(!raw||typeof raw!=="object")return null;

  const name=safeText(raw.name||raw.tokenName,100).trim();
  const symbol=safeText(raw.symbol||raw.tokenSymbol,10)
    .trim().toUpperCase();
  const supply=safeText(raw.supply||raw.totalSupply,40).trim();
  const decimals=Number(raw.decimals);
  const description=safeText(raw.description,1000).trim();

  const logoRaw=raw.logoData||raw.logoDataUrl||raw.logoBase64||
    raw.logoUrl||raw.logoURL||raw.logo||raw.image||raw.tokenLogo||"";

  const logoData=normalizeLogo(
    logoRaw,
    raw.logoMimeType||raw.mimeType
  );

  if(
    name.length<2||
    !/^[A-Z0-9._-]{2,10}$/.test(symbol)||
    !/^[1-9]\d*$/.test(supply)||
    supply.length>31||
    !Number.isInteger(decimals)||
    decimals<0||decimals>9||
    (raw.network&&raw.network!=="mainnet")
  )return null;

  try{
    const amount=BigInt(supply)*(10n**BigInt(decimals));
    if(amount<=0n||amount>10n**30n)return null;
  }catch(_){
    return null;
  }

  if(logoData.startsWith("data:")&&logoData.length>1400000)
    return null;

  if(logoRaw&&!logoData)return null;

  return {
    name,
    symbol,
    supply,
    decimals,
    description,
    logoData,
    network:"mainnet"
  };
}

function renderDraft(d){
  state.draft=d;

  $("VX03_name").textContent=d.name;
  $("VX03_symbol").textContent="$"+d.symbol;
  $("VX03_vname").textContent=d.name;
  $("VX03_vsymbol").textContent=d.symbol;
  $("VX03_supply").textContent=d.supply;
  $("VX03_decimals").textContent=String(d.decimals);
  $("VX03_description").textContent=
    d.description||"No description provided.";

  const img=$("VX03_logo");

  if(d.logoData){
    img.src=d.logoData;
    img.alt=d.name+" token logo";
  }else{
    img.alt="Token logo";
  }

  status(
    "VX03_reviewStatus",
    "Token details loaded. Review them before continuing."
  );

  refreshButtons();
}

function resetOrder(message){
  state.order=null;
  state.paymentReady=false;
  state.servicePaid=false;

  $("VX03_feeAmount").textContent="Create order to check fee";
  $("VX03_accept").checked=false;

  status("VX03_deployState","Not verified");
  status("VX03_deploymentStatus","");
  show("VX03_payService",false);
  show("VX03_verifyService",false);
  show("VX03_deploymentCard",false);
  closeSuccessPopup();

  if(message)status("VX03_serviceStatus",message);
  refreshButtons();
}

function onDraft(event){
  const d=parseDraft(event&&event.detail);

  if(!d){
    status(
      "VX03_reviewStatus",
      "Token details are missing or invalid. Return to Step 02 and check the form."
    );
    return;
  }

  resetOrder("Review the fee and create a new order.");
  renderDraft(d);
}

window.addEventListener("vxton:token-draft",onDraft);
document.addEventListener("vxton:token-draft",onDraft);
window.addEventListener("vxton:open-review",onDraft);

const existing=window.VXTON_TOKEN_DRAFT||window.MAGROXIN_TOKEN_DRAFT;
if(existing)onDraft({detail:existing});

let feeQuoteSequence=0;

async function loadFeeQuote(){
  const sequence=++feeQuoteSequence;
  if(!connectedMainnet()){
    $("VX03_feeAmount").textContent="Connect wallet to load fee";
    return;
  }

  $("VX03_feeAmount").textContent="Checking wallet fee…";
  try{
    const data=await request("/api/fee-quote?walletAddress="+encodeURIComponent(state.address));
    if(sequence!==feeQuoteSequence||!connectedMainnet())return;
    if(!data||data.ok!==true||!data.amountNano)
      throw new Error("Backend did not return a valid fee quote.");
    $("VX03_feeAmount").textContent=formatNanoTon(data.amountNano);
  }catch(e){
    if(sequence!==feeQuoteSequence)return;
    $("VX03_feeAmount").textContent="Fee quote unavailable";
    status("VX03_serviceStatus",e&&e.message||"Could not load wallet-specific service fee.");
  }
}

function walletReady(){
  if(!state.wallet||!state.address){
    state.friendlyAddress="";
    status("VX03_walletStatus","Wallet not connected.");
  }else{
    state.friendlyAddress=state.address.trim();

    status(
      "VX03_walletStatus",
      connectedMainnet()
        ?"Wallet connected · TON Mainnet"
        :"Wallet connected, but switch to TON Mainnet."
    );

  }

  refreshButtons();
  loadFeeQuote();
}

async function initWallet(){
  try{
    if(!window.TON_CONNECT_UI){
      await new Promise((resolve,reject)=>{
        const s=document.createElement("script");
        s.src="https://unpkg.com/@tonconnect/ui@2.0.9/dist/tonconnect-ui.min.js";
        s.onload=resolve;
        s.onerror=()=>reject(new Error("Could not load TON Connect."));
        document.head.appendChild(s);
      });
    }

    const TonConnectUI=window.TON_CONNECT_UI&&
      window.TON_CONNECT_UI.TonConnectUI;

    if(!TonConnectUI)
      throw new Error("TON Connect UI library unavailable.");

    state.tonUI=new TonConnectUI({
      manifestUrl:API+"/tonconnect-manifest.json",
      buttonRootId:"VX03_walletMount"
    });

// MAGROXIN — Shared TON Connect Wallet Bridge
window.MAGROXIN_TON_UI = state.tonUI;

    state.tonUI.onStatusChange(wallet=>{
      const oldAddress=state.address;
      const newAddress=wallet&&wallet.account
        ?wallet.account.address:"";

      state.wallet=wallet||null;
      state.address=newAddress;

      if(state.order&&oldAddress!==newAddress){
        resetOrder(
          "Wallet changed or disconnected. Connect the intended wallet and create a new order."
        );
      }

      walletReady();
    });

    walletReady();

  }catch(e){
    status(
      "VX03_walletStatus",
      e&&e.message||"Wallet initialization failed."
    );
  }
}

async function disconnectWallet(){
  if(!state.tonUI){
    status("VX03_walletStatus","TON Connect is not initialized.");
    return;
  }

  const btn=$("VX03_disconnectWallet");
  button("VX03_disconnectWallet",true,"Disconnecting…");

  try{
    await state.tonUI.disconnect();

    state.wallet=null;
    state.address="";
    state.friendlyAddress="";

    resetOrder("Wallet disconnected. Connect again to continue.");
    walletReady();

    status("VX03_walletStatus","Wallet disconnected.");

  }catch(e){
    status(
      "VX03_walletStatus",
      e&&e.message||"Could not disconnect wallet."
    );
  }finally{
    button("VX03_disconnectWallet",false,"Disconnect Wallet");
    walletReady();
  }
}

async function request(path,options){
  const response=await fetch(API+path,options||{});
  const data=await response.json().catch(()=>({}));

  if(!response.ok){
    const detailText=Array.isArray(data.details)
      ?data.details.map(x=>(x.field?x.field+": ":"")+(x.message||"")).filter(Boolean).join(" · ")
      :"";
    throw new Error((data.error||"API request failed ("+response.status+").")+(detailText?" ["+detailText+"]":""));
  }

  return data;
}

function formatNanoTon(nano){
  if(!/^\d+$/.test(String(nano)))
    throw new Error("Backend returned an invalid fee amount.");

  const n=BigInt(String(nano));
  const whole=n/1000000000n;
  const frac=(n%1000000000n).toString()
    .padStart(9,"0").replace(/0+$/,"");

  return whole.toString()+(frac?"."+frac:"")+" TON";
}

async function createOrder(){
  if(!state.draft||!state.wallet||!state.address)
    throw new Error("Connect your wallet and complete token details first.");

  if(!connectedMainnet())
    throw new Error("Switch your wallet to TON Mainnet.");

  if(!$("VX03_accept").checked)
    throw new Error("Accept the fee policy to continue.");

  const token={
    name:state.draft.name,
    symbol:state.draft.symbol,
    supply:state.draft.supply,
    decimals:state.draft.decimals,
    description:state.draft.description
  };

  if(state.draft.logoData){
    if(state.draft.logoData.startsWith("data:image/")) token.logoData=state.draft.logoData;
    else if(/^https:\/\//i.test(state.draft.logoData)) token.logoUrl=state.draft.logoData;
  }

  const data=await request("/api/orders",{
    method:"POST",
    headers:{"Content-Type":"application/json"},
    body:JSON.stringify({
      walletAddress:state.address,
      deploymentNetwork:"mainnet",
      token
    })
  });

  if(!data.order||!data.order.id)
    throw new Error("Backend did not return an order ID.");

  const order=data.order;
  const nano=order.amountNano;

  if(
    nano===undefined||nano===null||
    !/^[1-9]\d*$/.test(String(nano))
  ){
    throw new Error("Backend order has no valid fee amount. Payment blocked.");
  }

  if(order.feeTon!==undefined&&order.feeTon!==null){
    if(!/^\d+(?:\.\d{1,9})?$/.test(String(order.feeTon)))
      throw new Error("Backend returned an invalid TON fee.");

    const parts=String(order.feeTon).split(".");
    const expected=BigInt(parts[0])*1000000000n+
      BigInt((parts[1]||"").padEnd(9,"0")||"0");

    if(expected!==BigInt(String(nano)))
      throw new Error("Order fee fields do not match. Payment blocked.");
  }

  state.order={...order,walletAddress:state.address};

  state.paymentReady=!!(
    data.payment&&
    data.payment.paymentRequestEnabled===true&&
    data.payment.paymentVerificationEnabled===true
  );

  $("VX03_feeAmount").textContent=formatNanoTon(nano);

  show("VX03_payService",state.paymentReady);
  show("VX03_verifyService",state.paymentReady);

  status(
    "VX03_serviceStatus",
    state.paymentReady
      ?"Order created. Check the amount and recipient in your wallet before sending."
      :"Order created, but backend payment requests or verification are disabled."
  );

  refreshButtons();
}

async function getServicePayment(){
  if(!state.order)
    throw new Error("Create an order first.");

  if(!state.paymentReady)
    throw new Error("Backend payment requests and verification are not both enabled.");

  if(
    !connectedMainnet()||
    state.address!==state.order.walletAddress
  ){
    throw new Error("Reconnect the wallet that created this order.");
  }

  const p=await request(
    "/api/orders/"+encodeURIComponent(state.order.id)+"/payment-request"
  );

  if(p.network!==MAINNET)
    throw new Error("Payment request is not TON Mainnet.");

  if(String(p.amountNano)!==String(state.order.amountNano))
    throw new Error("Payment amount does not match this order. Payment blocked.");

  if(!p.address||typeof p.address!=="string")
    throw new Error("Backend payment recipient address is missing.");

  if(
    p.validUntil===undefined||p.validUntil===null||
    !Number.isFinite(Number(p.validUntil))||
    Number(p.validUntil)<=Math.floor(Date.now()/1000)
  ){
    throw new Error("Payment request is expired or invalid.");
  }

  if(
    p.payload!==undefined&&p.payload!==null&&
    typeof p.payload!=="string"
  ){
    throw new Error("Backend returned an invalid payment payload.");
  }

  return {
    ...p,
    validUntil:Number(p.validUntil),
    payload:p.payload||""
  };
}

function advanceToDeployer(){
  if(!state.servicePaid||!state.order||!state.order.id||!state.address||!state.draft)return;
  const bridgeData={
    orderId:state.order.id,
    walletAddress:state.address,
    network:"mainnet",
    token:{
      name:state.draft.name||"",
      symbol:state.draft.symbol||"",
      supply:state.draft.supply||"",
      decimals:state.draft.decimals??9,
      description:state.draft.description||"",
      logo:state.draft.logoData||"",
      logoUrl:state.draft.logoData&&/^https:\/\//i.test(state.draft.logoData)?state.draft.logoData:""
    }
  };
  window.MAGROXIN_GADGET4_DATA=bridgeData;
  window.dispatchEvent(new CustomEvent("magroxin:gadget4:open",{detail:bridgeData}));
}

async function verifyService(){
  if(!state.order)
    throw new Error("Create an order first.");

  if(
    !connectedMainnet()||
    state.address!==state.order.walletAddress
  ){
    throw new Error("Reconnect the wallet that created this order.");
  }

  const data=await request(
    "/api/orders/"+encodeURIComponent(state.order.id)+"/verify",
    {
      method:"POST",
      headers:{"Content-Type":"application/json"},
      body:JSON.stringify({walletAddress:state.address})
    }
  );

  if(data.status==="paid"&&data.paymentMarkedPaid===true){
    state.servicePaid=true;

    status("VX03_deployState","Payment verified");

    status(
      "VX03_serviceStatus",
      "Service payment verified by the backend."
    );

    status(
      "VX03_deploymentStatus",
      "Payment verified successfully by the backend."
    );

    // Prepare Gadget 4, then show the verified-payment popup above it.
    advanceToDeployer();
    refreshButtons();
    openSuccessPopup();
    return true;
  }

  status(
    "VX03_serviceStatus",
    data.message||"Payment is not confirmed yet. No success popup will be shown."
  );

  return false;
}

async function payService(){
  const p=await getServicePayment();

  await state.tonUI.sendTransaction({
    validUntil:p.validUntil,
    network:MAINNET,
    messages:[{
      address:p.address,
      amount:String(p.amountNano),
      payload:p.payload
    }]
  });

  status(
    "VX03_serviceStatus",
    "Transaction submitted. Waiting for backend verification…"
  );

  const ok=await verifyService();

  if(!ok){
    status(
      "VX03_serviceStatus",
      "Transaction submitted, but backend has not verified payment yet. Use Verify service-fee payment later."
    );
  }
}

async function run(id,action,statusId,label){
  if(state.busy)return;

  state.busy=true;
  refreshButtons();

  const n=$(id);
  const old=n.textContent;

  button(id,true,label||"Please wait…");

  try{
    await action();
  }catch(e){
    status(statusId,e&&e.message||"Request failed.");
  }finally{
    state.busy=false;
    button(id,false,old);
    refreshButtons();
  }
}

$("VX03_accept").addEventListener("change",refreshButtons);

$("VX03_createOrder").addEventListener("click",()=>{
  run(
    "VX03_createOrder",
    createOrder,
    "VX03_serviceStatus",
    "Creating order…"
  );
});

$("VX03_payService").addEventListener("click",()=>{
  run(
    "VX03_payService",
    payService,
    "VX03_serviceStatus",
    "Opening wallet…"
  );
});

$("VX03_verifyService").addEventListener("click",()=>{
  run(
    "VX03_verifyService",
    verifyService,
    "VX03_serviceStatus",
    "Verifying…"
  );
});

$("VX03_disconnectWallet").addEventListener(
  "click",
  disconnectWallet
);

$("VX03_popupClose").addEventListener("click",closeSuccessPopup);
$("VX03_popupContinue").addEventListener("click",()=>{
  closeSuccessPopup();
  const deployer=document.getElementById("MGX_GADGET4");
  if(deployer)deployer.scrollIntoView({behavior:"smooth",block:"center"});
});

initWallet();
})();
</script>
