    if (!home || home.dataset.vx01Init === "1") return;
    home.dataset.vx01Init = "1";

    /* Install one shared background for the token creator page. */
    var bg = document.getElementById("VXTON_GLOBAL_BG");

    if (!bg) {
      bg = document.createElement("div");
      bg.id = "VXTON_GLOBAL_BG";
      bg.setAttribute("aria-hidden", "true");
      bg.innerHTML =
        '<div class="vxbg-aurora vxbg-a1"></div>' +
        '<div class="vxbg-aurora vxbg-a2"></div>' +
        '<div class="vxbg-aurora vxbg-a3"></div>' +
