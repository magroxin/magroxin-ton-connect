<script>
(function(){
"use strict";
const ROOT=document.getElementById("MGX_GADGET4");
if(!ROOT||ROOT.dataset.ready==="yes")return;
ROOT.dataset.ready="yes";
const API="https://magroxin-ton-api.onrender.com";
const MAINNET="-239";
const $=id=>document.getElementById(id);
const modal=$("MGX4_MODAL");
/* Move the modal outside Blogger's clipped/transformed containers. */
if(modal && modal.parentElement!==document.body)document.body.appendChild(modal);
let backendEnabled=false,checking=false,deploying=false,completed=false;
let orderData=null,tokenAddress="";
function setStatus(title,message,state){
 $("MGX4_STATUS_TITLE").textContent=title;
 $("MGX4_STATUS_TEXT").textContent=message;
 $("MGX4_STATUS").dataset.state=state||"";
}
function refreshButton(){
 const ready=backendEnabled&&!!orderData&&!checking&&!deploying&&!completed;
 $("MGX4_DEPLOY").disabled=!ready;
 $("MGX4_DEPLOY_HINT").textContent=ready
  ?"✦ Backend enabled · Paid order received"
  :!backendEnabled?"🔒 Disabled · Backend not enabled"
  :!orderData?"🔒 Waiting for Gadget 3 payment verification"
  :deploying?"⏳ Deployment in progress":"Deployment already submitted";
}
async function api(path,options){
 const opts=Object.assign({cache:"no-store",headers:{"Accept":"application/json"}},options||{});
 const response=await fetch(API+path,opts);
 const data=await response.json().catch(()=>({}));
 if(!response.ok&&response.status!==202)throw new Error(data.error||data.message||"Request failed ("+response.status+").");
 return {response,data};
}
function firstValue(){
 for(const v of arguments){
  if(v!==undefined&&v!==null&&String(v).trim()!=="")return v;
 }
 return "";
}
function readGadget3Fields(){
 const get=id=>{
  const el=document.getElementById(id);
  if(!el)return "";
  if(el.tagName==="INPUT"||el.tagName==="TEXTAREA"||el.tagName==="SELECT")return el.value||"";
  return el.textContent||"";
 };
 return {
  name:get("VX03_name"),
  symbol:get("VX03_symbol"),
  logo:get("VX03_logo"),
  supply:get("VX03_supply"),
  decimals:get("VX03_decimals"),
  description:get("VX03_description")
 };
}
function normalizeToken(detail){
 const eventToken=detail.token&&typeof detail.token==="object"?detail.token:{};
 const dom=readGadget3Fields();
 return {
  name:firstValue(eventToken.name,eventToken.tokenName,detail.name,dom.name),
  symbol:firstValue(eventToken.symbol,eventToken.tokenSymbol,detail.symbol,dom.symbol),
  logo:firstValue(eventToken.logo,eventToken.image,eventToken.imageUrl,detail.logo,dom.logo),
  supply:firstValue(eventToken.supply,eventToken.totalSupply,detail.supply,dom.supply),
  decimals:firstValue(eventToken.decimals,detail.decimals,dom.decimals),
  description:firstValue(eventToken.description,detail.description,dom.description)
 };
}
function acceptOrder(detail){
 if(!detail||typeof detail!=="object")return;
 const id=detail.orderId||detail.order_id;
 const address=detail.walletAddress||detail.creatorAddress||detail.wallet_address;
 if(typeof id!=="string"||!id.trim()||typeof address!=="string"||!address.trim())return;
 if(detail.network&&detail.network!=="mainnet"&&detail.network!==MAINNET){
  setStatus("Wrong network","Gadget 3 did not provide a TON Mainnet order.","error");return;
 }
 orderData={orderId:id.trim(),walletAddress:address.trim(),network:"mainnet",token:normalizeToken(detail)};
 ROOT.style.display="block";
 refreshButton();
 setStatus(backendEnabled?"Order received":"Deployment disabled",
 backendEnabled?"Paid order received. Check wallet connection before deploying.":"Render has not enabled token deployment.",""+(backendEnabled?"ok":"error"));
}
window.addEventListener("magroxin:gadget4:open",e=>acceptOrder(e.detail));
window.addEventListener("magroxin:gadget4:order",e=>acceptOrder(e.detail));
async function checkBackend(){
 if(checking||deploying)return;
 checking=true;$("MGX4_CHECK").disabled=true;$("MGX4_CHECK").textContent="⟳ CHECKING BACKEND…";
 refreshButton();setStatus("Checking Render backend","Reading live deployment permission.","busy");
 try{
  const r=await api("/");
  backendEnabled=r.data.deploymentEnabled===true;
  if(!backendEnabled)setStatus("Deployment is disabled","Render returned deploymentEnabled=false. No transaction can be sent.","error");
  else if(!orderData)setStatus("Backend is enabled","Complete and verify service-fee payment in Gadget 3 first.","ok");
  else setStatus("Backend enabled","Paid order received. Deployment is available if the wallet session matches.","ok");
 }catch(e){backendEnabled=false;setStatus("Backend check failed",e.message,"error")}
 finally{
  checking=false;$("MGX4_CHECK").disabled=false;$("MGX4_CHECK").textContent="⟳ CHECK BACKEND";refreshButton();
 }
}
function getWalletUI(){
 const ui=window.MAGROXIN_TON_UI;
 return ui&&typeof ui.sendTransaction==="function"&&typeof ui.onStatusChange==="function"?ui:null;
}
function getConnectedWallet(){
 const ui=getWalletUI();
 if(!ui)throw new Error("Gadget 3 wallet session is not exposed to Gadget 4. No transaction was sent.");
 const wallet=ui.wallet;
 if(!wallet||!wallet.account||!wallet.account.address)throw new Error("Wallet is not connected. Return to Gadget 3 and connect it.");
 if(wallet.account.chain&&wallet.account.chain!==MAINNET)throw new Error("Connect a TON Mainnet wallet.");
 return {ui,address:wallet.account.address};
}
async function verifyDeployment(orderId,walletAddress){
 const deadline=Date.now()+120000;
 while(Date.now()<deadline){
  await new Promise(resolve=>setTimeout(resolve,2500));
  const r=await api("/api/deployment/verify",{
   method:"POST",headers:{"Content-Type":"application/json","Accept":"application/json"},
   body:JSON.stringify({orderId,walletAddress,network:"mainnet"})
  });
  const d=r.data;
  if(d.deploymentEnabled===false){backendEnabled=false;refreshButton();throw new Error("Render disabled deployment. No deployment was confirmed.")}
  if(d.status==="deployed"&&d.verifiedOnChain===true&&d.tokenAddress)return d;
  if(d.status==="failed"||d.retryable===false)throw new Error(d.error||"Backend could not verify deployment.");
  setStatus("Verifying on TON Mainnet",d.message||"Waiting for on-chain confirmation…","busy");
 }
 throw new Error("Verification is still pending. No success popup was shown. Check status before retrying.");
}
function setText(id,value){
 $(id).textContent=value===undefined||value===null||value===""?"Not provided by backend":String(value);
}
function showSuccess(verified){
 if(verified.status!=="deployed"||verified.verifiedOnChain!==true||!verified.tokenAddress)
  throw new Error("Deployment has not been verified by the backend.");
 const token=orderData.token||{};
 setText("MGX4_R_NAME",firstValue(verified.tokenName,verified.name,token.name));
 setText("MGX4_R_SYMBOL",firstValue(verified.tokenSymbol,verified.symbol,token.symbol));
 setText("MGX4_R_ADDRESS",verified.tokenAddress);
 setText("MGX4_R_DECIMALS",firstValue(verified.decimals,token.decimals));
 setText("MGX4_R_SUPPLY",firstValue(verified.totalSupply,verified.supply,token.supply));
 setText("MGX4_R_CREATOR",firstValue(verified.creatorAddress,verified.walletAddress,orderData.walletAddress));
 const logo=firstValue(verified.tokenLogo,verified.logo,token.logo);
 const logoEl=$("MGX4_R_LOGO");
 if(typeof logo==="string"&&/^(https?:\/\/|data:image\/)/i.test(logo)){
  logoEl.src=logo;logoEl.style.display="block";
 }else{logoEl.removeAttribute("src");logoEl.style.display="none"}
 const rawDate=firstValue(verified.deployedAt,verified.timestamp,verified.transactionTimestamp);
 let dateText="Not provided by backend";
 if(rawDate!==""){
  const date=typeof rawDate==="number"?new Date(rawDate<1000000000000?rawDate*1000:rawDate):new Date(rawDate);
  if(!Number.isNaN(date.getTime()))dateText=date.toLocaleString();
 }
 setText("MGX4_R_DATE",dateText);
 setText("MGX4_R_HASH",firstValue(verified.transactionHash,verified.txHash));
 const exp=$("MGX4_R_EXPLORER");exp.replaceChildren();
 const addLink=(url,label)=>{
  const a=document.createElement("a");a.href=url;a.target="_blank";a.rel="noopener noreferrer";a.textContent=label;exp.appendChild(a);
 };
 const safeAddress=encodeURIComponent(verified.tokenAddress);
 addLink("https://tonviewer.com/"+safeAddress,"View token on TON Explorer");
 const hash=firstValue(verified.transactionHash,verified.txHash);
 if(hash&&/^[A-Za-z0-9_-]+$/.test(String(hash))){
  const sep=document.createTextNode(" · ");exp.appendChild(sep);
  addLink("https://tonviewer.com/transaction/"+encodeURIComponent(hash),"View transaction");
 }
 tokenAddress=verified.tokenAddress;
 modal.classList.add("open");
 modal.setAttribute("aria-hidden","false");
 $("MGX4_CLOSE").focus();
 setStatus("Deployment verified","Backend confirmed the token master on TON Mainnet. Creator token balance should be checked separately.","ok");
}
async function deployToken(){
 if(deploying||checking||completed||!backendEnabled||!orderData)return;
 deploying=true;refreshButton();
 try{
  setStatus("Rechecking deployment permission","Checking Render immediately before transaction preparation.","busy");
  const live=await api("/");
  backendEnabled=live.data.deploymentEnabled===true;
  if(!backendEnabled)throw new Error("Render has deployment disabled. No transaction was sent.");
  if(orderData.network!=="mainnet")throw new Error("Order is not for TON Mainnet.");
  const wallet=getConnectedWallet();
  if(wallet.address!==orderData.walletAddress)throw new Error("Connected wallet does not match the wallet that paid the service fee.");
  setStatus("Preparing transaction","Requesting a deployment transaction from the backend.","busy");
  const r=await api("/api/deployment/prepare",{
   method:"POST",headers:{"Content-Type":"application/json","Accept":"application/json"},
   body:JSON.stringify({orderId:orderData.orderId,walletAddress:wallet.address,network:"mainnet"})
  });
  const p=r.data,tx=p.transaction;
  if(p.deploymentEnabled!==true||p.status!=="prepared"||!tx||tx.network!==MAINNET||!Array.isArray(tx.messages)||!tx.messages.length)
   throw new Error(p.error||"The deployment service returned an invalid response.");
  setStatus("Wallet approval required","Review the transaction in your connected TON wallet.","busy");
  await wallet.ui.sendTransaction(tx);
  setStatus("Waiting for verification","Waiting for backend confirmation on-chain.","busy");
  const verified=await verifyDeployment(orderData.orderId,wallet.address);
  showSuccess(verified);completed=true;
 }catch(e){setStatus("Deployment not confirmed",e.message||"Deployment failed or is still pending.","error")}
 finally{deploying=false;refreshButton()}
}
function closeModal(){
 modal.classList.remove("open");modal.setAttribute("aria-hidden","true");
 $("MGX4_DEPLOY").focus();
}
$("MGX4_CHECK").addEventListener("click",checkBackend);
$("MGX4_DEPLOY").addEventListener("click",deployToken);
$("MGX4_CLOSE").addEventListener("click",closeModal);
modal.addEventListener("click",e=>{if(e.target===modal)closeModal()});
document.addEventListener("keydown",e=>{if(e.key==="Escape"&&modal.classList.contains("open"))closeModal()});
$("MGX4_COPY").addEventListener("click",async()=>{
 if(!tokenAddress)return;
 try{
  await navigator.clipboard.writeText(tokenAddress);
  $("MGX4_COPY").textContent="COPIED ✓";
  setTimeout(()=>$("MGX4_COPY").textContent="COPY CONTRACT ADDRESS",1500);
 }catch(e){setStatus("Copy failed","Select the contract address and copy it manually.","error")}
});
refreshButton();
checkBackend();
})();
