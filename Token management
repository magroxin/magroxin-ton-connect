<script>
(function(){
"use strict";

const MAGROXIN_TELEGRAM_URL="";
const MANIFEST_URL="https://magroxin-ton-api.onrender.com/tonconnect-manifest.json";
const TONAPI="https://tonapi.io";
const TONAPI_KEY="";
const MAINNET="-239";
const OP={
 MINT:21,
 CHANGE_ADMIN:3,
 CHANGE_CONTENT:4,
 INTERNAL_TRANSFER:0x178d4519,
 BURN:0x595f07bc
};

const root=document.getElementById("MGX_TOKEN_MANAGER");
if(!root||root.dataset.ready)return;

/* =====================================
   MAGROXIN TOP LEVEL LAYER PROTECTION
===================================== */

if(root.parentElement!==document.body){
 document.body.appendChild(root);
}

/* Do not create a top-level stacking context here.
   TON Connect renders its wallet modal outside this gadget.
   The manager overlay itself owns the high z-index. */
root.style.setProperty("position","static","important");
root.style.setProperty("z-index","auto","important");
root.style.setProperty("isolation","auto","important");

root.dataset.ready="1";

const $=id=>root.querySelector("#"+id);

const S={
 wallet:null,tc:null,core:null,master:null,wallets:[],
 admin:null,adminOK:false,info:null,
 decimals:9,jwallet:null,balance:0n,balanceDecimals:9
};

const status=(id,msg,kind="")=>{
 const e=$(id);
 e.textContent=msg;
 e.className="status "+kind;
};

const toast=msg=>{
 const e=$("mgxToast");
 e.textContent=msg;
 e.classList.remove("hidden");
 clearTimeout(toast.t);
 toast.t=setTimeout(()=>e.classList.add("hidden"),3800);
};

const short=x=>x?String(x).slice(0,8)+"…"+String(x).slice(-7):"—";

const headers=()=>TONAPI_KEY?{Authorization:"Bearer "+TONAPI_KEY}:{};

async function api(path){
 const r=await fetch(TONAPI+path,{headers:headers()});
 if(!r.ok)throw Error("TON API error "+r.status+". Try again later.");
 return r.json();
}

async function core(){
 if(!S.core)S.core=await import("https://esm.sh/@ton/core@0.60.1");
 return S.core;
}

function walletRequired(){
 if(!S.wallet)throw Error("Connect your wallet first.");
 if(String(S.wallet.account.chain)!==MAINNET)
  throw Error("Wrong network. Switch to TON Mainnet.");
}

function addr(a){
 return S.core.Address.parse(String(a).trim()).toString({
  bounceable:true,testOnly:false
 });
}

function raw(a){
 return S.core.Address.parse(a).toRawString();
}

function units(v,d){
 let n=BigInt(v),base=10n**BigInt(d);
 let f=(n%base).toString().padStart(d,"0").replace(/0+$/,"");
 return (n/base).toString()+(f?"."+f:"");
}

function amount(v,d){
 v=String(v).trim();
 if(!/^\d+(\.\d+)?$/.test(v))
  throw Error("Enter a valid positive amount.");
 let [w,f=""]=v.split(".");
 if(f.length>d)throw Error("Too many decimal places.");
 let n=BigInt(w)*(10n**BigInt(d))+
 BigInt((f+"0".repeat(d)).slice(0,d)||"0");
 if(n<=0n)throw Error("Amount must be greater than zero.");
 return n;
}

/* =====================================
   TON CONNECT INITIALIZATION
===================================== */

/* PRIVATE MAGROXIN TON CONNECT ENGINE — isolated UI and storage */
const MGX_STORAGE_PREFIX="magroxin_token_manager_tonconnect_v1_";
const mgxStorage={async getItem(k){try{return localStorage.getItem(MGX_STORAGE_PREFIX+k)}catch(_){return null}},async setItem(k,v){try{localStorage.setItem(MGX_STORAGE_PREFIX+k,v)}catch(_){}},async removeItem(k){try{localStorage.removeItem(MGX_STORAGE_PREFIX+k)}catch(_){}}};
async function initWallet(){
 try{
  status("mgxWalletStatus","Loading MAGROXIN private wallet engine…","warn");
  if(!S.tc){
   const mod=await import("https://esm.sh/@tonconnect/sdk@4.0.0");const TonConnect=mod.TonConnect||mod.default;
   if(!TonConnect)throw Error("TON Connect SDK could not initialize.");
   S.tc=new TonConnect({manifestUrl:MANIFEST_URL,storage:mgxStorage,walletsListCacheTTLMs:3600000});
   if(S.tc.setConnectionNetwork)S.tc.setConnectionNetwork(MAINNET);
   S.tc.onStatusChange(w=>{
    S.wallet=w||null;S.adminOK=false;clearTokenDetails(false);
    status("mgxWalletStatus",w?(String(w.account.chain)===MAINNET?"Connected · TON Mainnet · "+short(w.account.address):"Connected on wrong network. Switch to TON Mainnet."):"Wallet not connected.",w&&String(w.account.chain)===MAINNET?"ok":"");
    if(w&&String(w.account.chain)!==MAINNET)status("mgxLookupStatus","Switch your wallet to TON Mainnet before verifying ownership.","warn");else if(!w)status("mgxLookupStatus","Connect a TON Mainnet wallet first.");
    if(w)closeWalletPicker();
   });
   await S.tc.restoreConnection();if(S.tc.wallet)S.wallet=S.tc.wallet;
  }
  status("mgxWalletStatus",S.wallet?"Connected · "+short(S.wallet.account.address):"MAGROXIN private wallet engine ready.","ok");return true;
 }catch(e){S.tc=null;status("mgxWalletStatus",e.message||"Wallet engine initialization failed.","err");throw e;}
}
function closeWalletPicker(){$("mgxWalletPicker").classList.remove("open");$("mgxWalletPicker").setAttribute("aria-hidden","true");$("mgxWalletQR").classList.remove("show");$("mgxWalletLinkBox").innerHTML="";}
async function openWalletPicker(){
 const p=$("mgxWalletPicker");p.classList.add("open");p.setAttribute("aria-hidden","false");$("mgxWalletList").innerHTML="";$("mgxPickerStatus").textContent="Loading available wallets…";$("mgxWalletQR").classList.remove("show");
 try{await initWallet();S.wallets=await S.tc.getWallets();if(!S.wallets.length)throw Error("No compatible TON wallets were returned. Check your internet connection.");
  S.wallets.forEach((w,i)=>{const b=document.createElement("button");b.type="button";b.className="mgx-wallet-row";const img=document.createElement("img");img.src=w.imageUrl||"";img.alt="";img.onerror=()=>img.style.display="none";const label=document.createElement("span");label.textContent=w.name||"TON Wallet";b.append(img,label);b.addEventListener("click",()=>connectChosenWallet(i));$("mgxWalletList").appendChild(b);});
  $("mgxPickerStatus").textContent="Select your preferred wallet.";
 }catch(e){$("mgxPickerStatus").textContent=e.message||"Could not load wallets.";$("mgxPickerStatus").className="status err";}
}
async function connectChosenWallet(index){
 try{const w=S.wallets[index];if(!w)throw Error("Wallet option is no longer available.");$("mgxPickerStatus").textContent="Preparing secure connection…";
  if((w.embedded||w.injected)&&w.jsBridgeKey){S.tc.connect({jsBridgeKey:w.jsBridgeKey});$("mgxPickerStatus").textContent="Waiting for wallet approval…";return;}
  if(!w.bridgeUrl)throw Error("This wallet does not provide a supported TON Connect bridge.");
  const link=S.tc.connect({bridgeUrl:w.bridgeUrl,universalLink:w.universalLink||w.deepLink});if(!link)throw Error("Wallet did not provide a connection link.");
  $("mgxWalletQR").classList.add("show");$("mgxWalletLinkBox").innerHTML="";const a=document.createElement("a");a.className="mgx-wallet-open";a.href=link;a.target="_blank";a.rel="noopener noreferrer";a.textContent="OPEN "+(w.name||"WALLET");$("mgxWalletLinkBox").appendChild(a);
  try{const q=await import("https://esm.sh/qrcode@1.5.4");await(q.default||q).toCanvas($("mgxWalletQRCanvas"),link,{width:220,margin:1,color:{dark:"#071322",light:"#ffffff"}});}catch(_){$("mgxWalletQRCanvas").style.display="none";}
  $("mgxPickerStatus").textContent="Scan the QR code or tap OPEN WALLET, then approve inside your wallet.";$("mgxPickerStatus").className="status ok";
 }catch(e){$("mgxPickerStatus").textContent=e.message||"Could not start wallet connection.";$("mgxPickerStatus").className="status err";}
}
/* =====================================
   TOKEN VERIFICATION
===================================== */

async function loadToken(){
 try{
  await core();
  walletRequired();

  const master=addr($("mgxMaster").value);
  S.master=master;

  status("mgxLookupStatus","Reading Jetton details and checking wallet permissions…");
  $("mgxDetails").classList.remove("show");

  const [info,owned]=await Promise.all([
   api("/v2/jettons/"+encodeURIComponent(master)),
   api("/v2/accounts/"+encodeURIComponent(addr(S.wallet.account.address))+"/jettons")
  ]);

  let admin=info.admin?.address||
   info.admin_address||
   (typeof info.admin==="string"?info.admin:null);

  if(!admin)
   throw Error("TON API did not provide a verifiable admin address. Management is locked for safety.");

  S.admin=addr(admin);
  S.adminOK=raw(addr(S.wallet.account.address))===raw(S.admin);
  S.info=info;

  S.decimals=Number(info.metadata?.decimals??9);

  if(!Number.isInteger(S.decimals)||S.decimals<0||S.decimals>18)
   S.decimals=9;

  const item=(owned.balances||[]).find(x=>{
   try{return raw(x.jetton.address)===raw(master)}
   catch(_){return false}
  });

  S.jwallet=item?.wallet_address?.address||item?.wallet_address||null;
  S.balance=BigInt(item?.balance||"0");
  S.balanceDecimals=Number(item?.jetton?.decimals??S.decimals);

  $("mgxNameView").textContent=info.metadata?.name||"Unknown";
  $("mgxSymbolView").textContent=info.metadata?.symbol||"—";
  $("mgxSupplyView").textContent=units(info.total_supply||"0",S.decimals)+" "+(info.metadata?.symbol||"");
  $("mgxAdminView").textContent=short(S.admin);
  $("mgxBalanceView").textContent=units(S.balance,S.balanceDecimals)+" "+(info.metadata?.symbol||"");

  $("mgxEditName").value=info.metadata?.name||"";
  $("mgxEditSymbol").value=info.metadata?.symbol||"";
  $("mgxEditDescription").value=info.metadata?.description||"";
  $("mgxEditImage").value=info.metadata?.image||"";
  $("mgxDecimals").value=S.decimals;

  status(
   "mgxOwnerStatus",
   S.adminOK?
   "Verified: connected wallet matches the current admin. Admin controls unlocked.":
   "Not the current admin. Metadata edits, minting and revoke are locked. Burn is available only for your own balance.",
   S.adminOK?"ok":"warn"
  );

  ["mgxMetadataCard","mgxMintCard","mgxRevokeCard"].forEach(id=>{
   $(id).classList.toggle("hidden",!S.adminOK);
  });

  $("mgxDetails").classList.add("show");

  status("mgxLookupStatus","Token details loaded. Check the address and details carefully.","ok");

 }catch(e){
  status("mgxLookupStatus",e.message,"err");
 }
}

/* =====================================
   METADATA CELL
===================================== */

function snake(c,str){
 const bytes=new TextEncoder().encode(str);
 const chunks=[];

 for(let i=0;i<bytes.length;i+=120)
  chunks.push(bytes.slice(i,i+120));

 let next=null;

 for(let i=chunks.length-1;i>=0;i--){
  let b=c.beginCell();
  if(i===0)b.storeUint(0,8);
  b.storeBuffer(chunks[i]);
  if(next)b.storeRef(next);
  next=b.endCell();
 }

 return next||c.beginCell().storeUint(0,8).endCell();
}

async function metadataCell(c,fields){
 const {Buffer}=await import("https://esm.sh/buffer@6.0.3");
 const dict=c.Dictionary.empty(
  c.Dictionary.Keys.Buffer(32),
  c.Dictionary.Values.Cell()
 );

 for(const [k,v] of Object.entries(fields)){
  if(!v)continue;

  const hash=new Uint8Array(
   await crypto.subtle.digest("SHA-256",new TextEncoder().encode(k))
  );

  dict.set(Buffer.from(hash),snake(c,String(v)));
 }

 return c.beginCell().storeUint(0,8).storeDict(dict).endCell();
}

/* =====================================
   TRANSACTION
===================================== */

async function send(to,body,nano,id){
 walletRequired();

 status(id,"Preparing transaction…","warn");

 await S.tc.sendTransaction({
  validUntil:Math.floor(Date.now()/1000)+300,
  network:MAINNET,
  messages:[{
   address:to,
   amount:String(nano),
   payload:body.toBoc().toString("base64")
  }]
 });

 status(
  id,
  "Wallet approved the request. Submission requested. Check the transaction in your wallet or TON explorer; wallet approval alone is not proof of on-chain success.",
  "warn"
 );

 toast("Transaction request sent. Check TON Explorer.");
}

/* =====================================
   SAVE METADATA
===================================== */

async function saveMetadata(){
 try{
  walletRequired();

  if(!S.adminOK)
   throw Error("Current admin verification required.");

  const name=$("mgxEditName").value.trim();
  const symbol=$("mgxEditSymbol").value.trim();
  const description=$("mgxEditDescription").value.trim();
  const image=$("mgxEditImage").value.trim();

  if(!name||!symbol)
   throw Error("Name and symbol are required.");

  if(image&&!/^https:\/\/\S+$/i.test(image))
   throw Error("Logo URL must use HTTPS.");

  const c=await core();
  const content=await metadataCell(c,{name,symbol,description,image});

  const body=c.beginCell()
   .storeUint(OP.CHANGE_CONTENT,32)
   .storeUint(0,64)
   .storeRef(content)
   .endCell();

  await send(S.master,body,50000000,"mgxMetadataStatus");

 }catch(e){
  status("mgxMetadataStatus",e.message,"err");
 }
}

/* =====================================
   MINT
===================================== */

async function mint(){
 try{
  walletRequired();

  if(!S.adminOK)
   throw Error("Current admin verification required.");

  const c=await core();
  const to=c.Address.parse(addr($("mgxMintTo").value));
  const owner=c.Address.parse(S.wallet.account.address);
  const n=amount($("mgxMintAmount").value,S.decimals);

  const internal=c.beginCell()
   .storeUint(OP.INTERNAL_TRANSFER,32)
   .storeUint(0,64)
   .storeCoins(n)
   .storeAddress(null)
   .storeAddress(owner)
   .storeCoins(1000000)
   .storeBit(0)
   .endCell();

  const body=c.beginCell()
   .storeUint(OP.MINT,32)
   .storeUint(0,64)
   .storeAddress(to)
   .storeCoins(300000000)
   .storeRef(internal)
   .endCell();

  await send(S.master,body,400000000,"mgxMintStatus");

 }catch(e){
  status("mgxMintStatus",e.message,"err");
 }
}

/* =====================================
   BURN
===================================== */

async function burn(){
 try{
  walletRequired();

  if(!S.jwallet)
   throw Error("Could not find your Jetton wallet. Refresh token details.");

  const n=amount($("mgxBurnAmount").value,S.balanceDecimals);

  if(n>S.balance)
   throw Error("Amount exceeds your own token balance.");

  const c=await core();
  const owner=c.Address.parse(S.wallet.account.address);

  const body=c.beginCell()
   .storeUint(OP.BURN,32)
   .storeUint(0,64)
   .storeCoins(n)
   .storeAddress(owner)
   .endCell();

  await send(addr(S.jwallet),body,100000000,"mgxBurnStatus");

 }catch(e){
  status("mgxBurnStatus",e.message,"err");
 }
}

/* =====================================
   REVOKE ADMIN
===================================== */

async function revoke(){
 try{
  walletRequired();

  if(!S.adminOK)
   throw Error("Current admin verification required.");

  if($("mgxRevokeWord").value.trim()!=="REVOKE")
   throw Error('Type exactly "REVOKE" to confirm.');

  if(!confirm(
   "IRREVERSIBLE: This permanently removes the admin. Minting and metadata edits will no longer be possible. Continue?"
  ))return;

  const c=await core();

  const body=c.beginCell()
   .storeUint(OP.CHANGE_ADMIN,32)
   .storeUint(0,64)
   .storeAddress(null)
   .endCell();

  await send(S.master,body,50000000,"mgxRevokeStatus");

  $("mgxRevokeWord").value="";

 }catch(e){
  status("mgxRevokeStatus",e.message,"err");
 }
}

